{
  "manifest_version": 3,
  "name": "TabWise",
  "version": "0.2.2",
  "description": "A privacy-first tab manager with safe suspension and local smart organization.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "tabGroups",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_permissions": ["history"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "TabWise",
    "default_popup": "src/popup/popup.html"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "omnibox": {
    "keyword": "tw"
  },
  "commands": {
    "open-tabwise": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open TabWise page search"
    },
    "save-workspace": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save the current window as a workspace"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "src/options/options.html"
}
